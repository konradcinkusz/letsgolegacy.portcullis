<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- See Portcullis.Engine.csproj's own NoWarn comment: the mutation pass's mutant
         analyzers (Rules/Mutants/) trip the same Roslyn analyzer-authoring meta-rules,
         which don't apply to batch, test-only analyzer instances. RS1041 (a compiler
         extension in a net10.0 assembly) is the same case: the tests construct the
         mutants in-process; no compiler ever loads this assembly as an analyzer. -->
    <NoWarn>RS1036;RS2008;RS1030;RS1037;RS1032;RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Portcullis.Engine\Portcullis.Engine.csproj" />
    <!--
      Direct, although Portcullis.Engine already brings it in: these tests exercise the
      rules themselves, and Stryker.NET mutates only a project the test project references
      directly (docs/MUTATIONS.md, section 8).
    -->
    <ProjectReference Include="..\..\src\Portcullis.Rules\Portcullis.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validates Portcullis's SARIF output against the official schema (Sarif/SarifSchema.cs). -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official OASIS SARIF 2.1.0 schema, copied unchanged: see Sarif/THIRD-PARTY-NOTICE.md. -->
    <EmbeddedResource Include="Sarif\sarif-schema-2.1.0.json" LogicalName="sarif-schema-2.1.0.json" />
  </ItemGroup>

</Project>
