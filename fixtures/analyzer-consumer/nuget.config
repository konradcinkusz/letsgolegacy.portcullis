<?xml version="1.0" encoding="utf-8"?>
<!-- Portcullis.Analyzers comes only from the package CI has just packed into ./feed, never
     from a public feed; everything else (targeting packs an SDK does not bundle) from
     nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="portcullis-under-test" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="portcullis-under-test">
      <package pattern="Portcullis.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
